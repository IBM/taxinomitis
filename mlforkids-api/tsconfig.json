{
  "compilerOptions": {
    "target": "es2025",
    "lib": [
       "es2025"
    ],
    "module": "node20",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/**/*.ts",
    "custom_typings/**/*"
  ]
}
