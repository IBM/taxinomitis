
DOCKER_VERSION=1

DOCKER_ORG=dalelane
DOCKER_IMAGE=mlforkids-text

# valid combinations listed at
#  https://cloud.ibm.com/docs/codeengine?topic=codeengine-mem-cpu-combo
CPU=1
MEMORY=4G
DISK=1G

MIN_INSTANCES=1
MAX_INSTANCES=3

# the largest trainings take tens of seconds 
REQUEST_TIMEOUT=600

SERVICE_ACCOUNT=default
