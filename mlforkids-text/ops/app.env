
DOCKER_VERSION=5

DOCKER_ORG=dalelane
DOCKER_IMAGE=mlforkids-text

# valid combinations listed at
#  https://cloud.ibm.com/docs/codeengine?topic=codeengine-mem-cpu-combo
CPU=1
MEMORY=4G
DISK=1G

# 0 works too: everything is built to allow for a cold start (see DESIGN.md)
MIN_INSTANCES=1
MAX_INSTANCES=3

# trainings wait in the service, not in Code Engine, so Code Engine
#  mustn't hold requests back: that would make classify wait too
CONCURRENCY=100
CONCURRENCY_TARGET=10

# only there to catch failures: the slowest training, after a cold
#  start, is about 2 minutes
REQUEST_TIMEOUT=600

SERVICE_ACCOUNT=default
